# =====================================================================
#  SmartCart configuration.
#  Copy this file to ".env" and change the values marked CHANGE.
#      Windows (PowerShell):  copy .env.example .env
#      Mac / Linux:           cp .env.example .env
#  The ".env" file is private: it is listed in .gitignore, never commit it.
# =====================================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
# CHANGE: use letters and numbers only (no @ : / # characters)
POSTGRES_PASSWORD=ChangeMe123

# --- Login tokens ---
# CHANGE: any long random text, 32+ characters
JWT_SECRET=change-this-to-a-long-random-text-1234567890
# The account registered with this email becomes the admin
ADMIN_EMAIL=admin@smartcart.dev

# --- Payments (Stripe) ---
# Leave EMPTY to use MOCK payments (works instantly, no account needed).
# For real Stripe TEST mode paste your secret key (it starts with sk_test_).
STRIPE_SECRET_KEY=
CURRENCY=inr

# --- AI recommendations (OpenAI) ---
# Leave EMPTY to use a simple built-in fallback (works offline, not AI).
# Paste your key (starts with sk-) to use OpenAI embeddings.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MIN_SIMILARITY=0.25

# --- Emails ---
# Leave SMTP_HOST empty: emails are printed in the notification-service log.
# For real emails (example: Gmail with an App Password):
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_USER=you@gmail.com   SMTP_PASS=your-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SmartCart <no-reply@smartcart.dev>

# --- Ports on your machine ---
# Website:   http://localhost:3100   (on AWS set FRONTEND_PORT=80)
FRONTEND_PORT=3100
# Direct API access for testing with curl / the demo scripts
GATEWAY_PORT=8080
# Requests allowed per minute per IP at the gateway
RATE_LIMIT_PER_MIN=300
